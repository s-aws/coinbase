{
  "channel": "futures_balance_summary",
  "description": "Futures balance summary message format",
  "message_type": "futures_balance_summary",
  "response_structure": {
    "channel": "string - always 'futures_balance_summary'",
    "client_id": "string - empty string",
    "timestamp": "string - ISO8601 timestamp",
    "sequence_num": "integer - message sequence number",
    "events": [
      {
        "type": "string - 'snapshot' (initial) or 'update' (ongoing)",
        "fcm_balance_summary": {
          "futures_buying_power": "string - available to trade futures",
          "total_usd_balance": "string - total USD across accounts",
          "cbi_usd_balance": "string - USD in spot account (Coinbase Inc.)",
          "cfm_usd_balance": "string - USD in futures account (CFTC-regulated)",
          "total_open_orders_hold_amount": "string - hold for open orders",
          "unrealized_pnl": "string - current unrealized PnL on open positions",
          "daily_realized_pnl": "string - realized PnL today",
          "initial_margin": "string - margin required for positions",
          "available_margin": "string - margin available for new positions",
          "liquidation_threshold": "string - balance level triggering liquidation",
          "liquidation_buffer_amount": "string - cushion above liquidation threshold",
          "liquidation_buffer_percentage": "string - buffer as percentage",
          "intraday_margin_window_measure": {
            "margin_window_type": "string - FCM_MARGIN_WINDOW_TYPE_INTRADAY, OVERNIGHT, WEEKEND, TRANSITION",
            "margin_level": "string - MARGIN_LEVEL_TYPE_BASE, WARNING, DANGER, LIQUIDATION",
            "initial_margin": "string",
            "maintenance_margin": "string",
            "liquidation_buffer_percentage": "string",
            "total_hold": "string",
            "futures_buying_power": "string"
          },
          "overnight_margin_window_measure": {
            "margin_window_type": "string",
            "margin_level": "string",
            "initial_margin": "string",
            "maintenance_margin": "string",
            "liquidation_buffer_percentage": "string",
            "total_hold": "string",
            "futures_buying_power": "string"
          }
        }
      }
    ]
  },
