{
  "endpoint": "GET /api/v1/portfolios/{portfolio_uuid}",
  "method": "GET",
  "description": "Response structure for get portfolio details",
  "response": {
    "portfolio": {
      "uuid": "string - portfolio ID",
      "name": "string - portfolio name",
      "type": "string - STANDARD, UNKNOWN",
      "deleted": "boolean",
      "created_at": "string - ISO8601 timestamp",
      "updated_at": "string - ISO8601 timestamp"
    },
    "breakdown": {
      "portfolio_uuid": "string",
      "total_balance": {
        "value": "string - total portfolio value",
        "currency": "string"
      },
      "liquid_balance": {
        "value": "string - available balance",
        "currency": "string"
      },
      "account_holds": {
        "value": "string - amount on hold",
        "currency": "string"
      },
      "total_cbbtc_balance": {
        "value": "string - wrapped Bitcoin balance",
        "currency": "string"
      },
      "positions": {
        "value": "string - unrealized positions value",
        "currency": "string"
      }
    }
  },
  "status_codes": {
    "200": "Success",
    "401": "Unauthorized",
    "403": "Forbidden",
    "404": "Portfolio not found"
  },
  "example": {
    "portfolio": {
      "uuid": "018c4b12-9f87-7c36-897d-28fb6a1ea88d",
      "name": "Default Portfolio",
      "type": "STANDARD",
      "deleted": false,
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-15T10:30:45Z"
    },
    "breakdown": {
      "portfolio_uuid": "018c4b12-9f87-7c36-897d-28fb6a1ea88d",
      "total_balance": {
        "value": "10500.00",
        "currency": "USD"
      },
      "liquid_balance": {
        "value": "10000.00",
        "currency": "USD"
      },
      "account_holds": {
        "value": "500.00",
        "currency": "USD"
      },
      "total_cbbtc_balance": {
        "value": "0.0",
        "currency": "USD"
      },
      "positions": {
        "value": "250.00",
        "currency": "USD"
      }
    }
  }
}
