{
  "endpoint": "GET /api/v1/products",
  "method": "GET",
  "description": "Response structure for list products",
  "response": {
    "products": [
      {
        "product_id": "string - unique product identifier (e.g., BTC-USD)",
        "price": "string - current price",
        "price_percentage_change_24h": "string - percent change in 24h",
        "volume_24h": "string - trading volume in 24h",
        "volume_percentage_change_24h": "string - volume change percent",
        "base_increment": "string - minimum base currency increment",
        "display_name": "string - human-readable name",
        "status": "string - OPEN or CLOSED",
        "base_currency": "string - base currency code",
        "quote_currency": "string - quote currency code",
        "base_min_size": "string - minimum order size",
        "base_max_size": "string - maximum order size",
        "quote_increment": "string - minimum quote currency increment",
        "quote_min_size": "string - minimum quote amount",
        "quote_max_size": "string - maximum quote amount",
        "cancel_only": "boolean - whether only cancels are allowed",
        "limit_only": "boolean - whether only limit orders allowed",
        "post_only": "boolean - whether post-only orders required",
        "product_type": "string - SPOT or FUTURE",
        "id": "string - same as product_id",
        "baseName": "string - base currency name",
        "quoteName": "string - quote currency name",
        "watchlist_symbol": "string - symbol for watchlists",
        "fcm_trading_session_details": {
          "open": "string - opening time",
          "close": "string - closing time",
          "is_close": "boolean"
        }
      }
    ],
    "sequence": "string - sequence number",
    "has_next": "boolean - whether more results available"
  },
  "status_codes": {
    "200": "Success",
    "401": "Unauthorized",
    "403": "Forbidden"
  },
  "example": {
    "products": [
      {
        "product_id": "BTC-USD",
        "price": "42500.50",
        "price_percentage_change_24h": "2.50",
        "volume_24h": "156.78",
        "volume_percentage_change_24h": "1.20",
        "base_increment": "0.00000001",
        "display_name": "BTC/USD",
        "status": "OPEN",
        "base_currency": "BTC",
        "quote_currency": "USD",
        "base_min_size": "0.001",
        "base_max_size": "1000000",
        "quote_increment": "0.01",
        "quote_min_size": "10",
        "quote_max_size": "10000000",
        "cancel_only": false,
        "limit_only": false,
        "post_only": false,
        "product_type": "SPOT",
        "id": "BTC-USD",
        "baseName": "Bitcoin",
        "quoteName": "US Dollar",
        "watchlist_symbol": "BTC"
      },
      {
        "product_id": "ETH-USD",
        "price": "2200.75",
        "price_percentage_change_24h": "1.50",
        "volume_24h": "89.34",
        "volume_percentage_change_24h": "0.80",
        "base_increment": "0.00000001",
        "display_name": "ETH/USD",
        "status": "OPEN",
        "base_currency": "ETH",
        "quote_currency": "USD",
        "base_min_size": "0.01",
        "base_max_size": "1000000",
        "quote_increment": "0.01",
        "quote_min_size": "10",
        "quote_max_size": "10000000",
        "cancel_only": false,
        "limit_only": false,
        "post_only": false,
        "product_type": "SPOT",
        "id": "ETH-USD",
        "baseName": "Ethereum",
        "quoteName": "US Dollar",
        "watchlist_symbol": "ETH"
      }
    ],
    "sequence": "12345",
    "has_next": false
  }
}
