{
  "endpoint": "GET /api/v1/perpetual_orders",
  "method": "GET",
  "description": "Get list of open perpetual (futures) orders",
  "authentication": "Bearer token (OAuth2)",
  "query_parameters": {
    "limit": {
      "type": "integer",
      "description": "Number of orders to return (default 50, max 100)",
      "required": false
    },
    "after": {
      "type": "string",
      "description": "Pagination cursor",
      "required": false
    },
    "product_id": {
      "type": "string",
      "description": "Filter by specific futures product",
      "required": false
    }
  },
  "headers": {
    "Authorization": "Bearer <access_token>",
    "Content-Type": "application/json"
  },
  "notes": "Returns open orders for perpetual futures contracts"
}
