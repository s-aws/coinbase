{
  "endpoint": "DELETE /api/v1/orders/{order_id}",
  "method": "DELETE",
  "description": "Response structure for cancel order",
  "response": {
    "success": "boolean - whether cancellation was successful",
    "cancel_request_id": "string - unique cancel request identifier",
    "order_id": "string - echoed order ID",
    "status": "string - CANCELLED if successful"
  },
  "status_codes": {
    "200": "Success - order cancelled",
    "400": "Bad Request - order cannot be cancelled",
    "401": "Unauthorized",
    "403": "Forbidden",
    "404": "Order not found",
    "409": "Conflict - order state prevents cancellation"
  },
  "example": {
    "success": true,
    "cancel_request_id": "8e9f4c3a-e2f1-4b6d-9c8e-7a5d3f2e1c0b",
    "order_id": "7c4a3d3e-e8f2-4e7a-9c1d-5a6e9f2b8c1d"
  }
}
