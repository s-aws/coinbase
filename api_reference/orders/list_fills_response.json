{
  "endpoint": "GET /api/v1/orders/historical/fills",
  "method": "GET",
  "description": "Response structure for list fills",
  "response": {
    "fills": [
      {
        "entry_id": "string - unique fill identifier",
        "trade_id": "string - unique trade identifier",
        "order_id": "string - order that was filled",
        "trade_time": "string - ISO8601 timestamp",
        "price": "string - price per unit",
        "size": "string - quantity filled",
        "fee": "string - fee for this fill",
        "side": "string - BUY or SELL",
        "liquidity": "string - MAKER or TAKER",
        "product_id": "string - product traded",
        "user_fee_rate": "string - fee rate applied",
        "user_id": "string - user ID",
        "commission": "string - commission amount",
        "settlement_currency": "string - currency settled in"
      }
    ],
    "sequence": "string - current sequence",
    "has_next": "boolean"
  },
  "status_codes": {
    "200": "Success",
    "401": "Unauthorized",
    "403": "Forbidden"
  }
}
