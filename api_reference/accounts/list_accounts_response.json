{
  "endpoint": "GET /api/v1/accounts",
  "method": "GET",
  "description": "Response structure for list accounts",
  "response": {
    "accounts": [
      {
        "uuid": "string - unique account identifier",
        "name": "string - display name of account",
        "currency": "string - currency code (USD, BTC, ETH, etc.)",
        "available_balance": {
          "value": "string - decimal balance",
          "currency": "string - currency code"
        },
        "default": "boolean - whether this is the default account",
        "active": "boolean - whether the account is active",
        "created_at": "string - ISO8601 timestamp",
        "updated_at": "string - ISO8601 timestamp",
        "deleted_at": "string - ISO8601 timestamp (null if active)",
        "type": "string - account type (ACCOUNT, VAULT, WALLET)"
      }
    ],
    "sequence": "string - current sequence number for tracking state changes",
    "has_next": "boolean - whether more results are available"
  },
  "status_codes": {
    "200": "Success",
    "401": "Unauthorized - invalid or expired token",
    "403": "Forbidden - insufficient permissions"
  },
  "example": {
    "accounts": [
      {
        "uuid": "018c4b12-9f87-7c36-897d-28fb6a1ea88d",
        "name": "USD Wallet",
        "currency": "USD",
        "available_balance": {
          "value": "1234.56",
          "currency": "USD"
        },
        "default": true,
        "active": true,
        "created_at": "2024-01-01T00:00:00Z",
        "updated_at": "2024-01-15T10:30:45Z",
        "deleted_at": null,
        "type": "ACCOUNT"
      },
      {
        "uuid": "018c4b12-9f87-7c36-897d-28fb6a1ea88e",
        "name": "BTC Wallet",
        "currency": "BTC",
        "available_balance": {
          "value": "0.5",
          "currency": "BTC"
        },
        "default": false,
        "active": true,
        "created_at": "2024-01-01T00:00:00Z",
        "updated_at": "2024-01-15T10:30:45Z",
        "deleted_at": null,
        "type": "ACCOUNT"
      }
    ],
    "sequence": "12345",
    "has_next": false
  }
}
