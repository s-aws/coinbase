{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coinbase-engine.local/operator-api/v1/schema.json",
  "title": "Coinbase Engine Operator JSON-RPC Protocol",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/successResponse"},
    {"$ref": "#/$defs/errorResponse"},
    {"$ref": "#/$defs/notification"}
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "clientOrderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operatorMethod": {
      "enum": [
        "v1.session.bootstrap",
        "v1.runtime.status",
        "v1.runtime.pause",
        "v1.runtime.resume",
        "v1.runtime.shutdown",
        "v1.stealth.list",
        "v1.stealth.export",
        "v1.stealth.import",
        "v1.stealth.create",
        "v1.stealth.create_span",
        "v1.stealth.cancel",
        "v1.stealth.rehide",
        "v1.stealth.reprice_now",
        "v1.stealth.move_revealed",
        "v1.stealth.update_price_condition",
        "v1.stealth.clear_all",
        "v1.strategy.update_target",
        "v1.strategy.update_parent"
      ]
    },
    "operatorNotificationMethod": {
      "enum": [
        "v1.projection.runtime",
        "v1.projection.stealth_orders",
        "v1.market.ticker",
        "v1.market.spread_snapshot"
      ]
    },
    "operatorOutcome": {
      "enum": ["succeeded", "accepted_pending", "partial"]
    },
    "operatorErrorReason": {
      "enum": [
        "invalid_params",
        "engine_not_admitting",
        "not_found",
        "precondition_failed",
        "conflict",
        "unavailable",
        "operation_failed",
        "indeterminate"
      ]
    },
    "operatorErrorCode": {
      "enum": [-32700, -32600, -32601, -32602, -32603, -32001, -32002, -32003, -32004]
    },
    "engineState": {
      "enum": ["STARTING", "RUNNING", "PAUSING", "PAUSED", "DRAINING", "STOPPED"]
    },
    "orderSide": {"enum": ["BUY", "SELL"]},
    "followUpRevealDirection": {"enum": ["same", "opposite"]},
    "targetMovementType": {"enum": ["P", "A"]},
    "stealthSpanCreationMode": {
      "enum": ["independent_parents", "parent_children"]
    },
    "stealthSpanSizeDistribution": {
      "enum": ["equal", "ascending", "descending", "pyramid"]
    },
    "stealthSpanResultStatus": {"enum": ["success", "partial", "error"]},
    "stealthSpanOrderResultStatus": {
      "enum": ["created", "existing", "failed", "not_attempted"]
    },
    "stealthMoveReason": {"enum": ["manual_user_move", "operator_reprice"]},
    "revealPricingPolicy": {
      "enum": ["configured_limit", "top_of_book", "midpoint", null]
    },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "revealCondition": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "createOrderParams": {
      "type": "object",
      "required": [
        "client_order_id",
        "product_id",
        "side",
        "total_size",
        "limit_price",
        "reveal_condition"
      ],
      "properties": {
        "client_order_id": {"$ref": "#/$defs/clientOrderId"},
        "product_id": {"type": "string", "minLength": 1},
        "side": {"$ref": "#/$defs/orderSide"},
        "total_size": {"type": "number", "exclusiveMinimum": 0},
        "limit_price": {"type": "number", "exclusiveMinimum": 0},
        "reveal_condition": {"$ref": "#/$defs/revealCondition"},
        "reveal_pricing_policy": {"$ref": "#/$defs/revealPricingPolicy"},
        "sizing_strategy": {"type": "object"},
        "parent_client_order_id": {
          "oneOf": [{"$ref": "#/$defs/clientOrderId"}, {"type": "null"}]
        },
        "follow_up_reveal_direction": {"$ref": "#/$defs/followUpRevealDirection"},
        "notes": {"type": ["string", "null"]},
        "max_order_replacements": {"type": ["integer", "null"], "minimum": 0},
        "target_movement": {"type": "number", "minimum": 0},
        "target_movement_type": {"$ref": "#/$defs/targetMovementType"},
        "allow_partial_fills": {"type": "boolean"},
        "anchor_repricing_policy": {"type": ["object", "null"]},
        "enable_hotpoint_replication": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "createSpanParams": {
      "type": "object",
      "required": [
        "span_id",
        "product_id",
        "side",
        "total_size",
        "start_price",
        "price_step",
        "order_count",
        "size_distribution",
        "creation_mode",
        "reveal_condition"
      ],
      "properties": {
        "span_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "product_id": {"type": "string", "minLength": 1},
        "side": {"$ref": "#/$defs/orderSide"},
        "total_size": {"type": "number", "exclusiveMinimum": 0},
        "start_price": {"type": "number", "exclusiveMinimum": 0},
        "price_step": {"type": "number", "minimum": 0},
        "order_count": {"type": "integer", "minimum": 1},
        "size_distribution": {"$ref": "#/$defs/stealthSpanSizeDistribution"},
        "creation_mode": {"$ref": "#/$defs/stealthSpanCreationMode"},
        "reveal_condition": {"$ref": "#/$defs/revealCondition"},
        "reveal_pricing_policy": {"$ref": "#/$defs/revealPricingPolicy"},
        "sizing_strategy": {"type": "object"},
        "follow_up_reveal_direction": {"$ref": "#/$defs/followUpRevealDirection"},
        "notes": {"type": ["string", "null"]},
        "max_order_replacements": {"type": ["integer", "null"], "minimum": 0},
        "target_movement": {"type": "number", "minimum": 0},
        "target_movement_type": {"$ref": "#/$defs/targetMovementType"},
        "allow_partial_fills": {"type": "boolean"},
        "anchor_repricing_policy": {"type": ["object", "null"]},
        "enable_hotpoint_replication": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "stealthBackupV2": {
      "type": "object",
      "required": ["schema", "version", "orders"],
      "properties": {
        "schema": {"const": "coinbase.stealth-orders"},
        "version": {"const": 2},
        "exported_at": {"$ref": "#/$defs/timestamp"},
        "count": {"type": "integer", "minimum": 0},
        "orders": {
          "type": "array",
          "items": {"$ref": "#/$defs/createOrderParams"}
        }
      },
      "additionalProperties": false
    },
    "stealthBackupV1": {
      "type": "object",
      "required": ["version", "orders"],
      "properties": {
        "schema": {"type": "string"},
        "version": {"const": 1},
        "type": {"const": "export_active_stealth_orders_response"},
        "status": {"const": "success"},
        "exported_at": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "orders": {
          "type": "array",
          "items": {"type": "object"}
        }
      },
      "additionalProperties": false
    },
    "stealthBackupLegacyUnversioned": {
      "type": "object",
      "required": ["type", "orders"],
      "properties": {
        "schema": {"type": "string"},
        "type": {"const": "export_active_stealth_orders_response"},
        "status": {"const": "success"},
        "exported_at": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "orders": {
          "type": "array",
          "items": {"type": "object"}
        }
      },
      "not": {"required": ["version"]},
      "additionalProperties": false
    },
    "stealthBackupImportDocument": {
      "oneOf": [
        {"$ref": "#/$defs/stealthBackupV2"},
        {"$ref": "#/$defs/stealthBackupV1"},
        {"$ref": "#/$defs/stealthBackupLegacyUnversioned"}
      ]
    },
    "methodParams": {
      "type": "object",
      "required": [
        "v1.session.bootstrap",
        "v1.runtime.status",
        "v1.runtime.pause",
        "v1.runtime.resume",
        "v1.runtime.shutdown",
        "v1.stealth.list",
        "v1.stealth.export",
        "v1.stealth.import",
        "v1.stealth.create",
        "v1.stealth.create_span",
        "v1.stealth.cancel",
        "v1.stealth.rehide",
        "v1.stealth.reprice_now",
        "v1.stealth.move_revealed",
        "v1.stealth.update_price_condition",
        "v1.stealth.clear_all",
        "v1.strategy.update_target",
        "v1.strategy.update_parent"
      ],
      "properties": {
      "v1.session.bootstrap": {"$ref": "#/$defs/emptyParams"},
      "v1.runtime.status": {"$ref": "#/$defs/emptyParams"},
      "v1.runtime.pause": {"$ref": "#/$defs/emptyParams"},
      "v1.runtime.resume": {"$ref": "#/$defs/emptyParams"},
      "v1.runtime.shutdown": {
        "type": "object",
        "properties": {
          "timeout_seconds": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      },
      "v1.stealth.list": {"$ref": "#/$defs/emptyParams"},
      "v1.stealth.export": {"$ref": "#/$defs/emptyParams"},
      "v1.stealth.import": {
        "type": "object",
        "required": ["document"],
        "properties": {
          "document": {"$ref": "#/$defs/stealthBackupImportDocument"}
        },
        "additionalProperties": false
      },
      "v1.stealth.create": {"$ref": "#/$defs/createOrderParams"},
      "v1.stealth.create_span": {"$ref": "#/$defs/createSpanParams"},
      "v1.stealth.cancel": {
        "type": "object",
        "required": ["client_order_id"],
        "properties": {"client_order_id": {"$ref": "#/$defs/clientOrderId"}},
        "additionalProperties": false
      },
      "v1.stealth.rehide": {
        "type": "object",
        "required": ["client_order_id"],
        "properties": {"client_order_id": {"$ref": "#/$defs/clientOrderId"}},
        "additionalProperties": false
      },
      "v1.stealth.reprice_now": {
        "type": "object",
        "required": ["client_order_id"],
        "properties": {"client_order_id": {"$ref": "#/$defs/clientOrderId"}},
        "additionalProperties": false
      },
      "v1.stealth.move_revealed": {
        "type": "object",
        "required": ["client_order_id", "new_limit_price"],
        "properties": {
          "client_order_id": {"$ref": "#/$defs/clientOrderId"},
          "new_limit_price": {"type": "number", "exclusiveMinimum": 0},
          "reason": {"$ref": "#/$defs/stealthMoveReason"},
          "notes": {"type": ["string", "null"]},
          "new_target_movement": {"type": ["number", "null"], "minimum": 0},
          "new_target_movement_type": {
            "oneOf": [
              {"$ref": "#/$defs/targetMovementType"},
              {"type": "null"}
            ]
          }
        },
        "additionalProperties": false
      },
      "v1.stealth.update_price_condition": {
        "type": "object",
        "required": ["client_order_id", "price_threshold"],
        "properties": {
          "client_order_id": {"$ref": "#/$defs/clientOrderId"},
          "price_threshold": {"type": "number", "exclusiveMinimum": 0},
          "hold_duration_seconds": {"type": ["integer", "null"], "minimum": 0}
        },
        "additionalProperties": false
      },
      "v1.stealth.clear_all": {"$ref": "#/$defs/emptyParams"},
      "v1.strategy.update_target": {
        "type": "object",
        "required": ["parent_client_order_id", "target_movement", "target_movement_type"],
        "properties": {
          "parent_client_order_id": {"$ref": "#/$defs/clientOrderId"},
          "target_movement": {"type": "number", "minimum": 0},
          "target_movement_type": {"$ref": "#/$defs/targetMovementType"}
        },
        "additionalProperties": false
      },
      "v1.strategy.update_parent": {
        "type": "object",
        "required": ["client_order_id", "size", "price", "max_order_replacement", "status"],
        "properties": {
          "client_order_id": {"$ref": "#/$defs/clientOrderId"},
          "size": {"type": "number", "minimum": 0},
          "price": {"type": "number", "minimum": 0},
          "target_movement": {"type": ["number", "null"], "minimum": 0},
          "max_order_replacement": {"type": "integer", "minimum": 0},
          "status": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
      },
      "additionalProperties": false
    },
    "validationFieldError": {
      "type": "object",
      "required": ["path", "message", "rule"],
      "properties": {
        "path": {"type": "string"},
        "message": {"type": "string"},
        "rule": {"type": "string"}
      },
      "additionalProperties": false
    },
    "operatorErrorData": {
      "type": "object",
      "properties": {
        "reason": {"$ref": "#/$defs/operatorErrorReason"},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/validationFieldError"}
        },
        "retryable": {"type": "boolean"},
        "client_order_id": {"type": ["string", "null"]},
        "parent_client_order_id": {"type": ["string", "null"]},
        "span_id": {"type": ["string", "null"]},
        "stage": {"type": "string"},
        "engine_state": {"$ref": "#/$defs/engineState"},
        "category": {"type": "string"},
        "method": {"type": "string", "minLength": 1},
        "retry_after_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "runtimeStatus": {
      "type": "object",
      "required": [
        "engine_state",
        "is_admitting",
        "is_stopping",
        "startup_pause_pending",
        "inflight",
        "total_inflight",
        "timestamp"
      ],
      "properties": {
        "engine_state": {"$ref": "#/$defs/engineState"},
        "is_admitting": {"type": "boolean"},
        "is_stopping": {"type": "boolean"},
        "startup_pause_pending": {"type": "boolean"},
        "inflight": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "total_inflight": {"type": "integer", "minimum": 0},
        "timestamp": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "operatorCapabilities": {
      "type": "object",
      "required": [
        "methods",
        "notifications",
        "client_notifications",
        "batch_requests",
        "generic_idempotent_replay"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "items": {"$ref": "#/$defs/operatorMethod"},
          "uniqueItems": true
        },
        "notifications": {
          "type": "array",
          "items": {"$ref": "#/$defs/operatorNotificationMethod"},
          "uniqueItems": true
        },
        "client_notifications": {"const": false},
        "batch_requests": {"const": false},
        "generic_idempotent_replay": {"const": false}
      },
      "additionalProperties": false
    },
    "productMetadata": {
      "type": "object",
      "required": [
        "type",
        "base_currency",
        "quote_currency",
        "base_increment",
        "quote_increment",
        "price_increment",
        "base_min_size",
        "quote_min_size",
        "display_name",
        "status",
        "mid_price",
        "trading_disabled",
        "contract_size",
        "expiry"
      ],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "base_currency": {"type": ["string", "null"]},
        "quote_currency": {"type": ["string", "null"]},
        "base_increment": {"type": "string"},
        "quote_increment": {"type": "string"},
        "price_increment": {"type": "string"},
        "base_min_size": {"type": "string"},
        "quote_min_size": {"type": "string"},
        "display_name": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "mid_price": {"type": ["string", "number", "null"]},
        "trading_disabled": {"type": "boolean"},
        "contract_size": {"type": ["string", "null"]},
        "expiry": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "productCatalog": {
      "type": "object",
      "required": ["derivatives", "spot", "metadata"],
      "properties": {
        "derivatives": {
          "type": "array",
          "items": {"type": "string"}
        },
        "spot": {
          "type": "array",
          "items": {"type": "string"}
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/productMetadata"}
        }
      },
      "additionalProperties": false
    },
    "operatorStealthOrder": {
      "type": "object",
      "required": ["client_order_id"],
      "properties": {
        "client_order_id": {"$ref": "#/$defs/clientOrderId"},
        "parent_client_order_id": {
          "oneOf": [
            {"$ref": "#/$defs/clientOrderId"},
            {"type": "null"}
          ]
        },
        "product_id": {"type": "string"},
        "side": {"$ref": "#/$defs/orderSide"},
        "total_size": {"type": "number"},
        "limit_price": {"type": "number"},
        "revealed_size": {"type": "number"},
        "remaining_size": {"type": "number"},
        "executed_size": {"type": "number"},
        "status": {
          "enum": [
            "HIDDEN",
            "PENDING",
            "TRIGGERED",
            "REVEALED",
            "ERROR",
            "EXECUTED",
            "CANCELLED"
          ]
        },
        "visibility_score": {"type": "number"},
        "reveal_condition_type": {"type": "string"},
        "reveal_condition_json": {"type": "object"},
        "reveal_pricing_policy": {"type": ["string", "null"]},
        "follow_up_reveal_direction": {"$ref": "#/$defs/followUpRevealDirection"},
        "sizing_strategy_json": {"type": "object"},
        "reason": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]},
        "revealed_orders": {
          "type": "array",
          "items": {"type": "object"}
        },
        "anchor_repricing_policy_json": {"type": ["object", "null"]},
        "anchor_repricing_state_json": {"type": ["object", "null"]},
        "created_at": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"]},
        "condition_first_met_at": {"type": ["string", "null"]},
        "condition_confirmed_at": {"type": ["string", "null"]},
        "last_placement_at": {"type": ["string", "null"]},
        "failure_reason": {"type": ["string", "null"]},
        "allow_partial_fills": {"type": "boolean"},
        "parent_target_movement": {"type": ["number", "null"]},
        "parent_target_movement_type": {"type": ["string", "null"]},
        "parent_max_order_replacements": {"type": "integer", "minimum": 0},
        "max_order_replacements": {"type": ["integer", "null"], "minimum": 0},
        "target_movement": {"type": ["number", "null"]},
        "target_movement_type": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "stealthOrderMap": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/operatorStealthOrder"}
    },
    "repricingStatistics": {
      "type": "object",
      "required": [
        "active_repricing_count",
        "total_reprices_executed",
        "breakdown_by_source"
      ],
      "properties": {
        "active_repricing_count": {"type": "integer", "minimum": 0},
        "total_reprices_executed": {"type": "integer", "minimum": 0},
        "breakdown_by_source": {
          "type": "object",
          "required": ["last_trade", "midpoint", "top_of_book"],
          "properties": {
            "last_trade": {"type": "integer", "minimum": 0},
            "midpoint": {"type": "integer", "minimum": 0},
            "top_of_book": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stealthOrdersProjection": {
      "type": "object",
      "required": ["orders", "repricing_stats", "timestamp"],
      "properties": {
        "orders": {"$ref": "#/$defs/stealthOrderMap"},
        "repricing_stats": {"$ref": "#/$defs/repricingStatistics"},
        "timestamp": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "dashboardLogEntry": {
      "type": "object",
      "required": ["timestamp", "level", "message", "context"],
      "properties": {
        "timestamp": {"type": "string"},
        "level": {"type": "string"},
        "message": {"type": "string"},
        "context": {"type": "object"}
      },
      "additionalProperties": false
    },
    "marketMetricWindow": {
      "type": "object",
      "required": ["minutes", "avg", "delta_pct"],
      "properties": {
        "minutes": {"type": "number"},
        "avg": {"type": "number"},
        "delta_pct": {"type": "number"}
      },
      "additionalProperties": false
    },
    "marketMetric": {
      "type": "object",
      "required": ["price", "as_of", "windows"],
      "properties": {
        "price": {"type": "number"},
        "as_of": {"type": "number"},
        "windows": {
          "type": "array",
          "items": {"$ref": "#/$defs/marketMetricWindow"}
        }
      },
      "additionalProperties": true
    },
    "dashboardEngineStatus": {
      "type": "object",
      "required": [
        "running",
        "engine_state",
        "threads_active",
        "event_queue_depth",
        "taker_fee_rate",
        "effective_fee_rate",
        "target_movement_factor",
        "fee_regime_factor",
        "volume_ratio",
        "overnight_margin_active",
        "margin_window_type",
        "last_update",
        "is_admitting",
        "is_stopping",
        "startup_pause_pending",
        "inflight",
        "total_inflight",
        "timestamp"
      ],
      "properties": {
        "running": {"type": "boolean"},
        "engine_state": {"$ref": "#/$defs/engineState"},
        "threads_active": {"type": "integer", "minimum": 0},
        "event_queue_depth": {"type": "integer", "minimum": 0},
        "taker_fee_rate": {"type": ["number", "null"]},
        "effective_fee_rate": {"type": ["number", "null"]},
        "target_movement_factor": {"type": ["number", "null"]},
        "fee_regime_factor": {"type": ["number", "null"]},
        "volume_ratio": {"type": ["number", "null"]},
        "overnight_margin_active": {"type": ["boolean", "null"]},
        "margin_window_type": {"type": ["string", "null"]},
        "last_update": {"type": ["string", "null"]},
        "is_admitting": {"type": "boolean"},
        "is_stopping": {"type": "boolean"},
        "startup_pause_pending": {"type": "boolean"},
        "inflight": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "total_inflight": {"type": "integer", "minimum": 0},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "user_feed": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "dashboardState": {
      "type": "object",
      "required": [
        "orders",
        "positions",
        "stealth_orders",
        "engine_status",
        "logs",
        "market_metrics"
      ],
      "properties": {
        "orders": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "positions": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "stealth_orders": {"$ref": "#/$defs/stealthOrderMap"},
        "engine_status": {"$ref": "#/$defs/dashboardEngineStatus"},
